// BoiMix Domain ERD: Reports, moderation events, account strikes, admin actions, support tickets
// Paste this single domain file into https://dbdiagram.io/d for a smaller focused diagram.
// Master ERD: ../database_erd.dbml

// BoiMix Database ERD - domain subset
// Scope: Reports, moderation events, account strikes, admin actions, support tickets.

Project BoiMix_09_moderation_support {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL + PostGIS. Plans, passes, CMS, campaigns, and moderation rules are backend-controlled data.'
}

Enum user_role {
  user
  moderator
  admin
}

Enum account_status {
  active
  suspended
  deleted
}

Enum auth_provider {
  email
  google
  apple
}

Enum verification_status {
  pending
  approved
  rejected
  expired
}

Enum media_kind {
  book_cover
  book_back_cover
  book_inside_page
  book_toc
  book_index
  profile_avatar
  profile_cover
  verification_document
  chat_attachment
  cms_asset
}

Enum processing_status {
  pending
  processing
  completed
  failed
}

Enum listing_mode {
  sell
  borrow
  exchange
  donate
}

Enum listing_status {
  draft
  pending_review
  active
  paused
  archived
  rejected
}

Enum inventory_status {
  available
  borrowed
  reserved
  sold
  draft
  archived
}

Enum book_condition {
  new
  excellent
  good
  fair
  poor
}

Enum location_visibility {
  private
  approximate
  transaction_only
  public
}

Enum plan_kind {
  deposit_membership
  borrow_pass
  promo_plan
}

Enum billing_period {
  one_time
}

Enum membership_status {
  pending_payment
  active
  upgraded
  expired
  cancelled_by_admin
}

Enum pass_credit_status {
  active
  reserved
  consumed
  restored
  expired
}

Enum order_status {
  pending
  processing
  confirmed
  shipped
  delivered
  completed
  cancelled
  disputed
}

Enum payment_method {
  bkash
  nagad
  cod
  bank
  manual
}

Enum payment_status {
  pending
  requires_confirmation
  confirmed
  failed
  refunded
  cancelled
}

Enum shipment_status {
  pending
  packed
  shipped
  in_transit
  delivered
  returned
  failed
}

Enum wallet_tx_type {
  sale
  escrow
  withdrawal
  deposit
  membership
  borrow_pass
  borrow_fee
  refund
  adjustment
  free_credit
  donor_reward
}

Enum borrow_status {
  pending_owner_review
  counter_offered
  accepted
  rejected
  paid
  handed_over_by_owner
  borrow_active
  return_initiated
  completed
  disputed
  expired
}

Enum handover_method {
  meetup
  courier
}

Enum exchange_status {
  pending_proposal
  counter_offered
  accepted
  rejected
  handed_over
  completed
  disputed
  cancelled
}

Enum dispute_status {
  open
  under_review
  resolved
  rejected
}

Enum notification_type {
  system
  message
  borrow_request
  borrow_approved
  borrow_returned
  exchange_offer
  exchange_accepted
  review
  order
  wallet
  membership
  pass_expiry
}

Enum notification_channel {
  in_app
  websocket
  fcm
  email
}

Enum report_target_type {
  book
  user
  review
  message
  order
  borrow_order
  exchange_order
}

Enum report_status {
  submitted
  in_review
  resolved
  rejected
}

Enum strike_type {
  warning
  temporary_ban
  permanent_ban
}

Enum cms_status {
  draft
  published
  archived
}

Enum campaign_status {
  draft
  scheduled
  active
  ended
  archived
}


// Tables

Table users {
  id uuid [pk]
  email varchar [unique]
  phone varchar
  password_hash varchar
  role user_role [not null, default: 'user']
  status account_status [not null, default: 'active']
  email_verified boolean [not null, default: false]
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table media_assets {
  id uuid [pk]
  owner_user_id uuid
  kind media_kind [not null]
  cloudinary_public_id varchar [not null]
  original_url text [not null]
  mime_type varchar
  size_bytes int
  width int
  height int
  processing_status processing_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table report_categories {
  id uuid [pk]
  target_type report_target_type [not null]
  name varchar [not null]
  active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table reports {
  id uuid [pk]
  reporter_id uuid [not null]
  category_id uuid
  target_type report_target_type [not null]
  target_id uuid [not null]
  details text
  status report_status [not null, default: 'submitted']
  resolution text
  created_at timestamp [not null]
  resolved_at timestamp
}

Table report_events {
  id uuid [pk]
  report_id uuid [not null]
  actor_id uuid
  event_type varchar [not null]
  notes text
  created_at timestamp [not null]
}

Table account_strikes {
  id uuid [pk]
  user_id uuid [not null]
  report_id uuid
  type strike_type [not null]
  reason text
  starts_at timestamp [not null]
  expires_at timestamp
  created_at timestamp [not null]
}

Table moderation_actions {
  id uuid [pk]
  actor_id uuid [not null]
  target_type varchar [not null]
  target_id uuid [not null]
  action varchar [not null]
  reason text
  metadata json
  created_at timestamp [not null]
}

Table support_tickets {
  id uuid [pk]
  user_id uuid [not null]
  subject varchar [not null]
  status varchar [not null, default: 'open']
  created_at timestamp [not null]
  closed_at timestamp
}

Table support_ticket_messages {
  id uuid [pk]
  ticket_id uuid [not null]
  sender_id uuid [not null]
  body text [not null]
  created_at timestamp [not null]
}

// Relationships inside this domain
Ref: users.id < media_assets.owner_user_id
Ref: report_categories.id < reports.category_id
Ref: users.id < reports.reporter_id
Ref: reports.id < report_events.report_id
Ref: users.id < report_events.actor_id
Ref: users.id < account_strikes.user_id
Ref: reports.id < account_strikes.report_id
Ref: users.id < moderation_actions.actor_id
Ref: users.id < support_tickets.user_id
Ref: support_tickets.id < support_ticket_messages.ticket_id
Ref: users.id < support_ticket_messages.sender_id

// Cross-domain relationships intentionally stay in the master ERD.
