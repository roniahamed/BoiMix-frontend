// BoiMix Domain ERD: Realtime chat, message delivery/read state, presence, exchange proposal in chat, notifications, Firebase delivery
// Paste this single domain file into https://dbdiagram.io/d for a smaller focused diagram.
// Master ERD: ../database_erd.dbml

// BoiMix Database ERD - domain subset
// Scope: Realtime chat, message delivery/read state, presence, exchange proposal in chat, notifications, Firebase delivery.

Project BoiMix_08_chat_notifications {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL + PostGIS. Plans, passes, CMS, campaigns, and moderation rules are backend-controlled data.'
}

Enum user_role {
  user
  moderator
  admin
}

Enum account_status {
  active
  suspended
  deleted
}

Enum auth_provider {
  email
  google
  apple
}

Enum verification_status {
  pending
  approved
  rejected
  expired
}

Enum media_kind {
  book_cover
  book_back_cover
  book_inside_page
  book_toc
  book_index
  profile_avatar
  profile_cover
  verification_document
  chat_attachment
  cms_asset
}

Enum processing_status {
  pending
  processing
  completed
  failed
}

Enum listing_mode {
  sell
  borrow
  exchange
  donate
}

Enum listing_status {
  draft
  pending_review
  active
  paused
  archived
  rejected
}

Enum inventory_status {
  available
  borrowed
  reserved
  sold
  draft
  archived
}

Enum book_condition {
  new
  excellent
  good
  fair
  poor
}

Enum location_visibility {
  private
  approximate
  transaction_only
  public
}

Enum plan_kind {
  deposit_membership
  borrow_pass
  promo_plan
}

Enum billing_period {
  one_time
}

Enum membership_status {
  pending_payment
  active
  upgraded
  expired
  cancelled_by_admin
}

Enum pass_credit_status {
  active
  reserved
  consumed
  restored
  expired
}

Enum order_status {
  pending
  processing
  confirmed
  shipped
  delivered
  completed
  cancelled
  disputed
}

Enum payment_method {
  bkash
  nagad
  cod
  bank
  manual
}

Enum payment_status {
  pending
  requires_confirmation
  confirmed
  failed
  refunded
  cancelled
}

Enum shipment_status {
  pending
  packed
  shipped
  in_transit
  delivered
  returned
  failed
}

Enum wallet_tx_type {
  sale
  escrow
  withdrawal
  deposit
  membership
  borrow_pass
  borrow_fee
  refund
  adjustment
  free_credit
  donor_reward
}

Enum borrow_status {
  pending_owner_review
  counter_offered
  accepted
  rejected
  paid
  handed_over_by_owner
  borrow_active
  return_initiated
  completed
  disputed
  expired
}

Enum handover_method {
  meetup
  courier
}

Enum exchange_status {
  pending_proposal
  counter_offered
  accepted
  rejected
  handed_over
  completed
  disputed
  cancelled
}

Enum dispute_status {
  open
  under_review
  resolved
  rejected
}

Enum notification_type {
  system
  message
  borrow_request
  borrow_approved
  borrow_returned
  exchange_offer
  exchange_accepted
  review
  order
  wallet
  membership
  pass_expiry
}

Enum notification_channel {
  in_app
  websocket
  fcm
  email
}

Enum report_target_type {
  book
  user
  review
  message
  order
  borrow_order
  exchange_order
}

Enum report_status {
  submitted
  in_review
  resolved
  rejected
}

Enum strike_type {
  warning
  temporary_ban
  permanent_ban
}

Enum cms_status {
  draft
  published
  archived
}

Enum campaign_status {
  draft
  scheduled
  active
  ended
  archived
}


// Tables

Table users {
  id uuid [pk]
  email varchar [unique]
  phone varchar
  password_hash varchar
  role user_role [not null, default: 'user']
  status account_status [not null, default: 'active']
  email_verified boolean [not null, default: false]
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table media_assets {
  id uuid [pk]
  owner_user_id uuid
  kind media_kind [not null]
  cloudinary_public_id varchar [not null]
  original_url text [not null]
  mime_type varchar
  size_bytes int
  width int
  height int
  processing_status processing_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table conversations {
  id uuid [pk]
  context_type varchar
  context_id uuid
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table conversation_participants {
  conversation_id uuid [not null]
  user_id uuid [not null]
  last_read_at timestamp
  muted_at timestamp

  indexes {
    (conversation_id, user_id) [pk]
  }
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  body text
  created_at timestamp [not null]
  edited_at timestamp
  deleted_at timestamp
}

Table message_attachments {
  id uuid [pk]
  message_id uuid [not null]
  media_id uuid [not null]
  attachment_type varchar [not null]
}

Table message_receipts {
  message_id uuid [not null]
  user_id uuid [not null]
  delivered_at timestamp
  read_at timestamp

  indexes {
    (message_id, user_id) [pk]
  }
}

Table presence_sessions {
  id uuid [pk]
  user_id uuid [not null]
  connection_id varchar [not null]
  is_online boolean [not null, default: true]
  last_seen_at timestamp [not null]
}

Table message_exchange_proposals {
  id uuid [pk]
  message_id uuid [not null]
  exchange_order_id uuid
  offering_listing_id uuid [not null]
  requesting_listing_id uuid [not null]
  status varchar [not null, default: 'pending']
  created_at timestamp [not null]
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  actor_id uuid
  type notification_type [not null]
  title varchar [not null]
  description text
  action_url text
  is_read boolean [not null, default: false]
  removed_at timestamp
  created_at timestamp [not null]
}

Table notification_deliveries {
  id uuid [pk]
  notification_id uuid [not null]
  channel notification_channel [not null]
  status varchar [not null, default: 'pending']
  sent_at timestamp
  error_message text
}

Table notification_preferences {
  user_id uuid [pk]
  email_enabled boolean [not null, default: true]
  push_enabled boolean [not null, default: true]
  marketing_enabled boolean [not null, default: false]
  updated_at timestamp [not null]
}

// Relationships inside this domain
Ref: users.id < media_assets.owner_user_id
Ref: conversations.id < conversation_participants.conversation_id
Ref: users.id < conversation_participants.user_id
Ref: conversations.id < messages.conversation_id
Ref: users.id < messages.sender_id
Ref: messages.id < message_attachments.message_id
Ref: media_assets.id < message_attachments.media_id
Ref: messages.id < message_receipts.message_id
Ref: users.id < message_receipts.user_id
Ref: users.id < presence_sessions.user_id
Ref: messages.id < message_exchange_proposals.message_id
Ref: users.id < notifications.user_id
Ref: users.id < notifications.actor_id
Ref: notifications.id < notification_deliveries.notification_id
Ref: users.id < notification_preferences.user_id

// Cross-domain relationships intentionally stay in the master ERD.
