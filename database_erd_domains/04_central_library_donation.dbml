// BoiMix Domain ERD: Central library branches, inventory, queues, donation intake, pickup, quality check, donor rewards
// Paste this single domain file into https://dbdiagram.io/d for a smaller focused diagram.
// Master ERD: ../database_erd.dbml

// BoiMix Database ERD - domain subset
// Scope: Central library branches, inventory, queues, donation intake, pickup, quality check, donor rewards.

Project BoiMix_04_central_library_donation {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL + PostGIS. Plans, passes, CMS, campaigns, and moderation rules are backend-controlled data.'
}

Enum user_role {
  user
  moderator
  admin
}

Enum account_status {
  active
  suspended
  deleted
}

Enum auth_provider {
  email
  google
  apple
}

Enum verification_status {
  pending
  approved
  rejected
  expired
}

Enum media_kind {
  book_cover
  book_back_cover
  book_inside_page
  book_toc
  book_index
  profile_avatar
  profile_cover
  verification_document
  chat_attachment
  cms_asset
}

Enum processing_status {
  pending
  processing
  completed
  failed
}

Enum listing_mode {
  sell
  borrow
  exchange
  donate
}

Enum listing_status {
  draft
  pending_review
  active
  paused
  archived
  rejected
}

Enum inventory_status {
  available
  borrowed
  reserved
  sold
  draft
  archived
}

Enum book_condition {
  new
  excellent
  good
  fair
  poor
}

Enum location_visibility {
  private
  approximate
  transaction_only
  public
}

Enum plan_kind {
  deposit_membership
  borrow_pass
  promo_plan
}

Enum billing_period {
  one_time
}

Enum membership_status {
  pending_payment
  active
  upgraded
  expired
  cancelled_by_admin
}

Enum pass_credit_status {
  active
  reserved
  consumed
  restored
  expired
}

Enum order_status {
  pending
  processing
  confirmed
  shipped
  delivered
  completed
  cancelled
  disputed
}

Enum payment_method {
  bkash
  nagad
  cod
  bank
  manual
}

Enum payment_status {
  pending
  requires_confirmation
  confirmed
  failed
  refunded
  cancelled
}

Enum shipment_status {
  pending
  packed
  shipped
  in_transit
  delivered
  returned
  failed
}

Enum wallet_tx_type {
  sale
  escrow
  withdrawal
  deposit
  membership
  borrow_pass
  borrow_fee
  refund
  adjustment
  free_credit
  donor_reward
}

Enum borrow_status {
  pending_owner_review
  counter_offered
  accepted
  rejected
  paid
  handed_over_by_owner
  borrow_active
  return_initiated
  completed
  disputed
  expired
}

Enum handover_method {
  meetup
  courier
}

Enum exchange_status {
  pending_proposal
  counter_offered
  accepted
  rejected
  handed_over
  completed
  disputed
  cancelled
}

Enum dispute_status {
  open
  under_review
  resolved
  rejected
}

Enum notification_type {
  system
  message
  borrow_request
  borrow_approved
  borrow_returned
  exchange_offer
  exchange_accepted
  review
  order
  wallet
  membership
  pass_expiry
}

Enum notification_channel {
  in_app
  websocket
  fcm
  email
}

Enum report_target_type {
  book
  user
  review
  message
  order
  borrow_order
  exchange_order
}

Enum report_status {
  submitted
  in_review
  resolved
  rejected
}

Enum strike_type {
  warning
  temporary_ban
  permanent_ban
}

Enum cms_status {
  draft
  published
  archived
}

Enum campaign_status {
  draft
  scheduled
  active
  ended
  archived
}


// Tables

Table users {
  id uuid [pk]
  email varchar [unique]
  phone varchar
  password_hash varchar
  role user_role [not null, default: 'user']
  status account_status [not null, default: 'active']
  email_verified boolean [not null, default: false]
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table locations {
  id uuid [pk]
  display_address text
  private_address text
  street varchar
  city varchar
  district varchar
  thana varchar
  state varchar
  postal_code varchar
  country varchar [default: 'Bangladesh']
  lat decimal
  lng decimal
  visibility location_visibility [not null, default: 'transaction_only']
  created_at timestamp [not null]
}

Table media_assets {
  id uuid [pk]
  owner_user_id uuid
  kind media_kind [not null]
  cloudinary_public_id varchar [not null]
  original_url text [not null]
  mime_type varchar
  size_bytes int
  width int
  height int
  processing_status processing_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table book_metadata {
  id uuid [pk]
  isbn_10 varchar
  isbn_13 varchar [unique]
  title varchar [not null]
  slug varchar [unique, not null]
  publisher_id uuid
  language varchar
  edition varchar
  page_count int
  description text
  original_cover_url text
  source varchar [not null, default: 'manual']
  source_payload json
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table book_listings {
  id uuid [pk]
  book_id uuid [not null]
  owner_user_id uuid
  provider_type varchar [not null, default: 'user']
  location_id uuid
  condition book_condition [not null]
  condition_note text
  status listing_status [not null, default: 'draft']
  inventory_status inventory_status [not null, default: 'available']
  quantity_total int [not null, default: 1]
  quantity_available int [not null, default: 1]
  tags json
  is_featured boolean [not null, default: false]
  is_premium_book boolean [not null, default: false]
  is_donated_book boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table library_branches {
  id uuid [pk]
  name varchar [not null]
  location_id uuid
  active boolean [not null, default: true]
  created_at timestamp [not null]
}

Table library_inventory_items {
  id uuid [pk]
  listing_id uuid [not null]
  branch_id uuid
  copy_code varchar [unique]
  source varchar [not null]
  status inventory_status [not null, default: 'available']
  acquired_at timestamp
  created_at timestamp [not null]
}

Table library_inventory_events {
  id uuid [pk]
  inventory_item_id uuid [not null]
  event_type varchar [not null]
  actor_id uuid
  notes text
  created_at timestamp [not null]
}

Table library_collections {
  id uuid [pk]
  title varchar [not null]
  slug varchar [unique, not null]
  description text
  status cms_status [not null, default: 'draft']
  sort_order int [not null, default: 0]
  created_at timestamp [not null]
}

Table library_collection_items {
  collection_id uuid [not null]
  listing_id uuid [not null]
  sort_order int [not null, default: 0]

  indexes {
    (collection_id, listing_id) [pk]
  }
}

Table library_queue_entries {
  id uuid [pk]
  user_id uuid [not null]
  listing_id uuid [not null]
  membership_id uuid
  priority_score int [not null, default: 0]
  status varchar [not null, default: 'waiting']
  created_at timestamp [not null]
}

Table donation_requests {
  id uuid [pk]
  donor_id uuid [not null]
  status varchar [not null, default: 'submitted']
  pickup_location_id uuid
  notes text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table donation_items {
  id uuid [pk]
  donation_request_id uuid [not null]
  book_id uuid
  isbn varchar
  title varchar
  author_name varchar
  condition book_condition
  status varchar [not null, default: 'pending_review']
  accepted_listing_id uuid
  rejection_reason text
}

Table donation_pickups {
  id uuid [pk]
  donation_request_id uuid [not null]
  scheduled_at timestamp
  courier_name varchar
  tracking_number varchar
  status shipment_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table donation_quality_checks {
  id uuid [pk]
  donation_item_id uuid [not null]
  reviewer_id uuid [not null]
  result varchar [not null]
  notes text
  checked_at timestamp [not null]
}

Table donor_rewards {
  id uuid [pk]
  donor_id uuid [not null]
  donation_request_id uuid [not null]
  reward_type varchar [not null]
  reward_value decimal
  expires_at timestamp
  created_at timestamp [not null]
}

Table donor_reward_redemptions {
  id uuid [pk]
  reward_id uuid [not null]
  redeemed_by uuid [not null]
  redeemed_at timestamp [not null]
}

Table donor_profile_tags {
  id uuid [pk]
  user_id uuid [not null]
  tag varchar [not null]
  granted_at timestamp [not null]
}

// Relationships inside this domain
Ref: users.id < media_assets.owner_user_id
Ref: book_metadata.id < book_listings.book_id
Ref: users.id < book_listings.owner_user_id
Ref: locations.id < book_listings.location_id
Ref: locations.id < library_branches.location_id
Ref: book_listings.id < library_inventory_items.listing_id
Ref: library_branches.id < library_inventory_items.branch_id
Ref: library_inventory_items.id < library_inventory_events.inventory_item_id
Ref: users.id < library_inventory_events.actor_id
Ref: library_collections.id < library_collection_items.collection_id
Ref: book_listings.id < library_collection_items.listing_id
Ref: users.id < library_queue_entries.user_id
Ref: book_listings.id < library_queue_entries.listing_id
Ref: users.id < donation_requests.donor_id
Ref: locations.id < donation_requests.pickup_location_id
Ref: donation_requests.id < donation_items.donation_request_id
Ref: book_metadata.id < donation_items.book_id
Ref: book_listings.id < donation_items.accepted_listing_id
Ref: donation_requests.id < donation_pickups.donation_request_id
Ref: donation_items.id < donation_quality_checks.donation_item_id
Ref: users.id < donation_quality_checks.reviewer_id
Ref: users.id < donor_rewards.donor_id
Ref: donation_requests.id < donor_rewards.donation_request_id
Ref: donor_rewards.id < donor_reward_redemptions.reward_id
Ref: users.id < donor_reward_redemptions.redeemed_by
Ref: users.id < donor_profile_tags.user_id

// Cross-domain relationships intentionally stay in the master ERD.
