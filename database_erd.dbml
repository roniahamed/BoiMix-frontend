// BoiMix Database ERD
// Paste this file into https://dbdiagram.io/d
// Scope: current frontend features + planned backend data dependencies.

Project BoiMix {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL + PostGIS. Plans, passes, CMS, campaigns, and moderation rules are backend-controlled data.'
}

Enum user_role {
  user
  moderator
  admin
}

Enum account_status {
  active
  suspended
  deleted
}

Enum auth_provider {
  email
  google
  apple
}

Enum verification_status {
  pending
  approved
  rejected
  expired
}

Enum media_kind {
  book_cover
  book_back_cover
  book_inside_page
  book_toc
  book_index
  profile_avatar
  profile_cover
  verification_document
  chat_attachment
  cms_asset
}

Enum processing_status {
  pending
  processing
  completed
  failed
}

Enum listing_mode {
  sell
  borrow
  exchange
  donate
}

Enum listing_status {
  draft
  pending_review
  active
  paused
  archived
  rejected
}

Enum inventory_status {
  available
  borrowed
  reserved
  sold
  draft
  archived
}

Enum book_condition {
  new
  excellent
  good
  fair
  poor
}

Enum location_visibility {
  private
  approximate
  transaction_only
  public
}

Enum plan_kind {
  deposit_membership
  borrow_pass
  promo_plan
}

Enum billing_period {
  one_time
}

Enum membership_status {
  pending_payment
  active
  upgraded
  expired
  cancelled_by_admin
}

Enum pass_credit_status {
  active
  reserved
  consumed
  restored
  expired
}

Enum order_status {
  pending
  processing
  confirmed
  shipped
  delivered
  completed
  cancelled
  disputed
}

Enum payment_method {
  bkash
  nagad
  cod
  bank
  manual
}

Enum payment_status {
  pending
  requires_confirmation
  confirmed
  failed
  refunded
  cancelled
}

Enum shipment_status {
  pending
  packed
  shipped
  in_transit
  delivered
  returned
  failed
}

Enum wallet_tx_type {
  sale
  escrow
  withdrawal
  deposit
  membership
  borrow_pass
  borrow_fee
  refund
  adjustment
  free_credit
  donor_reward
}

Enum borrow_status {
  pending_owner_review
  counter_offered
  accepted
  rejected
  paid
  handed_over_by_owner
  borrow_active
  return_initiated
  completed
  disputed
  expired
}

Enum handover_method {
  meetup
  courier
}

Enum exchange_status {
  pending_proposal
  counter_offered
  accepted
  rejected
  handed_over
  completed
  disputed
  cancelled
}

Enum dispute_status {
  open
  under_review
  resolved
  rejected
}

Enum notification_type {
  system
  message
  borrow_request
  borrow_approved
  borrow_returned
  exchange_offer
  exchange_accepted
  review
  order
  wallet
  membership
  pass_expiry
}

Enum notification_channel {
  in_app
  websocket
  fcm
  email
}

Enum report_target_type {
  book
  user
  review
  message
  order
  borrow_order
  exchange_order
}

Enum report_status {
  submitted
  in_review
  resolved
  rejected
}

Enum strike_type {
  warning
  temporary_ban
  permanent_ban
}

Enum cms_status {
  draft
  published
  archived
}

Enum campaign_status {
  draft
  scheduled
  active
  ended
  archived
}

Table users {
  id uuid [pk]
  email varchar [unique]
  phone varchar
  password_hash varchar
  role user_role [not null, default: 'user']
  status account_status [not null, default: 'active']
  email_verified boolean [not null, default: false]
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table firebase_identities {
  id uuid [pk]
  user_id uuid [not null]
  provider auth_provider [not null]
  firebase_uid varchar [unique, not null]
  provider_email varchar
  raw_claims json
  created_at timestamp [not null]
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar [not null]
  revoked_at timestamp
  expires_at timestamp [not null]
  created_at timestamp [not null]
}

Table user_sessions {
  id uuid [pk]
  user_id uuid [not null]
  ip_address varchar
  user_agent text
  last_seen_at timestamp
  created_at timestamp [not null]
}

Table otp_codes {
  id uuid [pk]
  user_id uuid
  email varchar
  purpose varchar [not null]
  code_hash varchar [not null]
  attempts int [not null, default: 0]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null]
}

Table password_reset_requests {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar [not null]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null]
}

Table terms_acceptances {
  id uuid [pk]
  user_id uuid [not null]
  terms_version varchar [not null]
  privacy_version varchar [not null]
  accepted_at timestamp [not null]
}

Table user_profiles {
  user_id uuid [pk]
  username varchar [unique, not null]
  full_name varchar [not null]
  designation varchar
  bio text
  avatar_media_id uuid
  cover_media_id uuid
  reputation_score decimal
  public_rating decimal
  review_count int [not null, default: 0]
  verified_badge boolean [not null, default: false]
  donor_tag boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table user_preferences {
  user_id uuid [pk]
  language varchar [not null, default: 'bn']
  email_notifications boolean [not null, default: true]
  push_notifications boolean [not null, default: true]
  marketing_emails boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table user_social_links {
  id uuid [pk]
  user_id uuid [not null]
  label varchar [not null]
  url varchar [not null]
  created_at timestamp [not null]
}

Table reading_interests {
  id uuid [pk]
  name varchar [unique, not null]
}

Table user_reading_interests {
  user_id uuid [not null]
  interest_id uuid [not null]
  created_at timestamp [not null]

  indexes {
    (user_id, interest_id) [pk]
  }
}

Table follows {
  follower_id uuid [not null]
  following_id uuid [not null]
  created_at timestamp [not null]

  indexes {
    (follower_id, following_id) [pk]
  }
}

Table locations {
  id uuid [pk]
  display_address text
  private_address text
  street varchar
  city varchar
  district varchar
  thana varchar
  state varchar
  postal_code varchar
  country varchar [default: 'Bangladesh']
  lat decimal
  lng decimal
  visibility location_visibility [not null, default: 'transaction_only']
  created_at timestamp [not null]
}

Table user_locations {
  id uuid [pk]
  user_id uuid [not null]
  location_id uuid [not null]
  is_default boolean [not null, default: false]
  created_at timestamp [not null]
}

Table user_meetup_locations {
  id uuid [pk]
  user_id uuid [not null]
  location_id uuid [not null]
  name varchar [not null]
  is_default boolean [not null, default: false]
  visibility location_visibility [not null, default: 'transaction_only']
  created_at timestamp [not null]
}

Table student_verifications {
  id uuid [pk]
  user_id uuid [not null]
  institution_name varchar [not null]
  student_id_number varchar [not null]
  document_media_id uuid
  status verification_status [not null, default: 'pending']
  reviewer_id uuid
  rejection_reason text
  created_at timestamp [not null]
  reviewed_at timestamp
}

Table user_verifications {
  id uuid [pk]
  user_id uuid [not null]
  document_type varchar [not null]
  document_number varchar
  status verification_status [not null, default: 'pending']
  reviewer_id uuid
  rejection_reason text
  created_at timestamp [not null]
  reviewed_at timestamp
}

Table verification_documents {
  id uuid [pk]
  verification_id uuid [not null]
  media_id uuid [not null]
  side varchar
  created_at timestamp [not null]
}

Table user_devices {
  id uuid [pk]
  user_id uuid [not null]
  fcm_token varchar
  device_name varchar
  platform varchar
  last_seen_at timestamp
  created_at timestamp [not null]
}

Table security_events {
  id uuid [pk]
  user_id uuid [not null]
  event_type varchar [not null]
  ip_address varchar
  user_agent text
  metadata json
  created_at timestamp [not null]
}

Table account_deletion_requests {
  id uuid [pk]
  user_id uuid [not null]
  reason text
  requested_at timestamp [not null]
  scheduled_delete_at timestamp
  cancelled_at timestamp
}

Table media_assets {
  id uuid [pk]
  owner_user_id uuid
  kind media_kind [not null]
  cloudinary_public_id varchar [not null]
  original_url text [not null]
  mime_type varchar
  size_bytes int
  width int
  height int
  processing_status processing_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table media_variants {
  id uuid [pk]
  media_id uuid [not null]
  variant_name varchar [not null]
  url text [not null]
  format varchar [not null]
  size_bytes int
  width int
  height int
  created_at timestamp [not null]
}

Table media_processing_jobs {
  id uuid [pk]
  media_id uuid [not null]
  status processing_status [not null, default: 'pending']
  error_message text
  started_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
}

Table authors {
  id uuid [pk]
  name varchar [not null]
  slug varchar [unique]
  bio text
  created_at timestamp [not null]
}

Table publishers {
  id uuid [pk]
  name varchar [not null]
  slug varchar [unique]
  created_at timestamp [not null]
}

Table categories {
  id uuid [pk]
  name varchar [not null]
  bn_name varchar
  slug varchar [unique, not null]
  parent_id uuid
  image_media_id uuid
  created_at timestamp [not null]
}

Table book_metadata {
  id uuid [pk]
  isbn_10 varchar
  isbn_13 varchar [unique]
  title varchar [not null]
  slug varchar [unique, not null]
  publisher_id uuid
  language varchar
  edition varchar
  page_count int
  description text
  original_cover_url text
  source varchar [not null, default: 'manual']
  source_payload json
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table book_authors {
  book_id uuid [not null]
  author_id uuid [not null]

  indexes {
    (book_id, author_id) [pk]
  }
}

Table book_categories {
  book_id uuid [not null]
  category_id uuid [not null]

  indexes {
    (book_id, category_id) [pk]
  }
}

Table isbn_lookup_logs {
  id uuid [pk]
  isbn varchar [not null]
  source varchar [not null]
  found_local boolean [not null, default: false]
  user_id uuid
  created_at timestamp [not null]
}

Table book_listings {
  id uuid [pk]
  book_id uuid [not null]
  owner_user_id uuid
  provider_type varchar [not null, default: 'user']
  location_id uuid
  condition book_condition [not null]
  condition_note text
  status listing_status [not null, default: 'draft']
  inventory_status inventory_status [not null, default: 'available']
  quantity_total int [not null, default: 1]
  quantity_available int [not null, default: 1]
  tags json
  is_featured boolean [not null, default: false]
  is_premium_book boolean [not null, default: false]
  is_donated_book boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table book_listing_modes {
  id uuid [pk]
  listing_id uuid [not null]
  mode listing_mode [not null]
  price decimal
  original_price decimal
  deposit decimal
  borrow_fee decimal
  borrow_duration_days int
  exchange_value decimal
  exchange_preference text
  quantity int [not null, default: 1]
  active boolean [not null, default: true]
}

Table book_images {
  id uuid [pk]
  listing_id uuid [not null]
  media_id uuid [not null]
  image_role varchar [not null]
  sort_order int [not null, default: 0]
}

Table book_questions {
  id uuid [pk]
  listing_id uuid [not null]
  asker_id uuid [not null]
  question text [not null]
  created_at timestamp [not null]
}

Table book_answers {
  id uuid [pk]
  question_id uuid [not null]
  answerer_id uuid [not null]
  answer text [not null]
  created_at timestamp [not null]
}

Table review_eligibilities {
  id uuid [pk]
  user_id uuid [not null]
  target_type varchar [not null]
  target_id uuid [not null]
  source_type varchar [not null]
  source_id uuid [not null]
  used_at timestamp
  created_at timestamp [not null]
}

Table reviews {
  id uuid [pk]
  reviewer_id uuid [not null]
  target_type varchar [not null]
  target_id uuid [not null]
  eligibility_id uuid
  rating int [not null]
  body text
  transaction_type varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table review_helpful_votes {
  review_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp [not null]

  indexes {
    (review_id, user_id) [pk]
  }
}

Table badges {
  id uuid [pk]
  code varchar [unique, not null]
  name varchar [not null]
  description text
  weight int [not null, default: 0]
  icon_media_id uuid
  active boolean [not null, default: true]
}

Table user_badges {
  user_id uuid [not null]
  badge_id uuid [not null]
  awarded_reason text
  awarded_at timestamp [not null]

  indexes {
    (user_id, badge_id) [pk]
  }
}

Table reputation_scores {
  user_id uuid [pk]
  score decimal [not null, default: 0]
  avg_rating decimal
  review_count int [not null, default: 0]
  on_time_return_ratio decimal
  successful_exchange_count int [not null, default: 0]
  completed_sale_count int [not null, default: 0]
  dispute_ratio decimal
  updated_at timestamp [not null]
}

Table reputation_events {
  id uuid [pk]
  user_id uuid [not null]
  source_type varchar [not null]
  source_id uuid [not null]
  delta decimal [not null]
  reason text
  created_at timestamp [not null]
}

Table library_branches {
  id uuid [pk]
  name varchar [not null]
  location_id uuid
  active boolean [not null, default: true]
  created_at timestamp [not null]
}

Table library_inventory_items {
  id uuid [pk]
  listing_id uuid [not null]
  branch_id uuid
  copy_code varchar [unique]
  source varchar [not null]
  status inventory_status [not null, default: 'available']
  acquired_at timestamp
  created_at timestamp [not null]
}

Table library_inventory_events {
  id uuid [pk]
  inventory_item_id uuid [not null]
  event_type varchar [not null]
  actor_id uuid
  notes text
  created_at timestamp [not null]
}

Table library_collections {
  id uuid [pk]
  title varchar [not null]
  slug varchar [unique, not null]
  description text
  status cms_status [not null, default: 'draft']
  sort_order int [not null, default: 0]
  created_at timestamp [not null]
}

Table library_collection_items {
  collection_id uuid [not null]
  listing_id uuid [not null]
  sort_order int [not null, default: 0]

  indexes {
    (collection_id, listing_id) [pk]
  }
}

Table library_queue_entries {
  id uuid [pk]
  user_id uuid [not null]
  listing_id uuid [not null]
  membership_id uuid
  priority_score int [not null, default: 0]
  status varchar [not null, default: 'waiting']
  created_at timestamp [not null]
}

Table donation_requests {
  id uuid [pk]
  donor_id uuid [not null]
  status varchar [not null, default: 'submitted']
  pickup_location_id uuid
  notes text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table donation_items {
  id uuid [pk]
  donation_request_id uuid [not null]
  book_id uuid
  isbn varchar
  title varchar
  author_name varchar
  condition book_condition
  status varchar [not null, default: 'pending_review']
  accepted_listing_id uuid
  rejection_reason text
}

Table donation_pickups {
  id uuid [pk]
  donation_request_id uuid [not null]
  scheduled_at timestamp
  courier_name varchar
  tracking_number varchar
  status shipment_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table donation_quality_checks {
  id uuid [pk]
  donation_item_id uuid [not null]
  reviewer_id uuid [not null]
  result varchar [not null]
  notes text
  checked_at timestamp [not null]
}

Table donor_rewards {
  id uuid [pk]
  donor_id uuid [not null]
  donation_request_id uuid [not null]
  reward_type varchar [not null]
  reward_value decimal
  expires_at timestamp
  created_at timestamp [not null]
}

Table donor_reward_redemptions {
  id uuid [pk]
  reward_id uuid [not null]
  redeemed_by uuid [not null]
  redeemed_at timestamp [not null]
}

Table donor_profile_tags {
  id uuid [pk]
  user_id uuid [not null]
  tag varchar [not null]
  granted_at timestamp [not null]
}

Table membership_plans {
  id uuid [pk]
  code varchar [unique, not null]
  name varchar [not null]
  kind plan_kind [not null, default: 'deposit_membership']
  billing_period billing_period [not null, default: 'one_time']
  price decimal [not null]
  validity_days int [not null]
  borrow_value_limit decimal
  borrow_item_limit int
  borrow_duration_days int
  priority_weight int [not null, default: 0]
  benefits json
  refund_policy text
  is_public boolean [not null, default: true]
  is_active boolean [not null, default: true]
  archived_at timestamp
  effective_from timestamp
  effective_until timestamp
  created_by uuid
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table user_memberships {
  id uuid [pk]
  user_id uuid [not null]
  plan_id uuid [not null]
  plan_snapshot json [not null]
  member_number varchar [unique]
  status membership_status [not null, default: 'pending_payment']
  starts_at timestamp
  expires_at timestamp
  upgraded_from_membership_id uuid
  purchase_id uuid
  created_at timestamp [not null]
}

Table membership_events {
  id uuid [pk]
  membership_id uuid [not null]
  event_type varchar [not null]
  actor_id uuid
  metadata json
  created_at timestamp [not null]
}

Table borrow_pass_packages {
  id uuid [pk]
  code varchar [unique, not null]
  name varchar [not null]
  price decimal [not null]
  credit_count int [not null]
  validity_days int [not null]
  benefits json
  is_public boolean [not null, default: true]
  is_active boolean [not null, default: true]
  archived_at timestamp
  created_by uuid
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table user_borrow_passes {
  id uuid [pk]
  user_id uuid [not null]
  package_id uuid [not null]
  package_snapshot json [not null]
  purchase_id uuid
  starts_at timestamp [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null]
}

Table borrow_pass_credits {
  id uuid [pk]
  user_borrow_pass_id uuid [not null]
  user_id uuid [not null]
  status pass_credit_status [not null, default: 'active']
  reserved_for_borrow_order_id uuid
  consumed_for_borrow_order_id uuid
  expires_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table borrow_pass_usages {
  id uuid [pk]
  credit_id uuid [not null]
  borrow_order_id uuid [not null]
  action varchar [not null]
  created_at timestamp [not null]
}

Table free_borrow_credits {
  id uuid [pk]
  user_id uuid [not null]
  membership_id uuid
  source varchar [not null]
  status pass_credit_status [not null, default: 'active']
  expires_at timestamp [not null]
  used_for_borrow_order_id uuid
  created_at timestamp [not null]
}

Table monthly_donated_book_credits {
  id uuid [pk]
  user_id uuid [not null]
  membership_id uuid
  month_key varchar [not null]
  status pass_credit_status [not null, default: 'active']
  used_for_borrow_order_id uuid
  created_at timestamp [not null]
}

Table plan_purchases {
  id uuid [pk]
  user_id uuid [not null]
  purchasable_type varchar [not null]
  purchasable_id uuid [not null]
  purchasable_snapshot json [not null]
  payment_intent_id uuid
  amount decimal [not null]
  status payment_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table membership_upgrade_quotes {
  id uuid [pk]
  user_id uuid [not null]
  from_membership_id uuid [not null]
  to_plan_id uuid [not null]
  price_difference decimal [not null]
  expires_at timestamp [not null]
  accepted_at timestamp
  created_at timestamp [not null]
}

Table plan_change_logs {
  id uuid [pk]
  actor_id uuid [not null]
  target_type varchar [not null]
  target_id uuid [not null]
  action varchar [not null]
  before_data json
  after_data json
  created_at timestamp [not null]
}

Table wishlists {
  id uuid [pk]
  user_id uuid [unique, not null]
  created_at timestamp [not null]
}

Table wishlist_items {
  wishlist_id uuid [not null]
  listing_id uuid [not null]
  created_at timestamp [not null]

  indexes {
    (wishlist_id, listing_id) [pk]
  }
}

Table carts {
  id uuid [pk]
  user_id uuid [unique, not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table cart_items {
  id uuid [pk]
  cart_id uuid [not null]
  listing_id uuid [not null]
  quantity int [not null, default: 1]
  selected boolean [not null, default: true]
  created_at timestamp [not null]
}

Table borrow_carts {
  id uuid [pk]
  user_id uuid [unique, not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table borrow_cart_items {
  id uuid [pk]
  borrow_cart_id uuid [not null]
  listing_id uuid [not null]
  owner_id uuid [not null]
  deposit_required decimal
  borrow_fee decimal
  selected boolean [not null, default: true]
  created_at timestamp [not null]
}

Table wallets {
  id uuid [pk]
  user_id uuid [unique, not null]
  available_balance decimal [not null, default: 0]
  escrow_balance decimal [not null, default: 0]
  locked_deposit decimal [not null, default: 0]
  lifetime_earnings decimal [not null, default: 0]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table wallet_transactions {
  id uuid [pk]
  wallet_id uuid [not null]
  type wallet_tx_type [not null]
  amount decimal [not null]
  status payment_status [not null, default: 'pending']
  source_type varchar
  source_id uuid
  title varchar
