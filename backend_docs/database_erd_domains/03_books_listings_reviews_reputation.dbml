// BoiMix Domain ERD: Book metadata, ISBN lookup, listings, book images, Q&A, reviews, badges, reputation
// Paste this single domain file into https://dbdiagram.io/d for a smaller focused diagram.
// Master ERD: ../database_erd.dbml

// BoiMix Database ERD - domain subset
// Scope: Book metadata, ISBN lookup, listings, book images, Q&A, reviews, badges, reputation.

Project BoiMix_03_books_listings_reviews_reputation {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL + PostGIS. Plans, passes, CMS, campaigns, and moderation rules are backend-controlled data.'
}

Enum user_role {
  user
  moderator
  admin
}

Enum account_status {
  active
  suspended
  deleted
}

Enum auth_provider {
  email
  google
  apple
}

Enum verification_status {
  pending
  approved
  rejected
  expired
}

Enum media_kind {
  book_cover
  book_back_cover
  book_inside_page
  book_toc
  book_index
  profile_avatar
  profile_cover
  verification_document
  chat_attachment
  cms_asset
}

Enum processing_status {
  pending
  processing
  completed
  failed
}

Enum listing_mode {
  sell
  borrow
  exchange
  donate
}

Enum listing_status {
  draft
  pending_review
  active
  paused
  archived
  rejected
}

Enum inventory_status {
  available
  borrowed
  reserved
  sold
  draft
  archived
}

Enum book_condition {
  new
  excellent
  good
  fair
  poor
}

Enum location_visibility {
  private
  approximate
  transaction_only
  public
}

Enum plan_kind {
  deposit_membership
  borrow_pass
  promo_plan
}

Enum billing_period {
  one_time
}

Enum membership_status {
  pending_payment
  active
  upgraded
  expired
  cancelled_by_admin
}

Enum pass_credit_status {
  active
  reserved
  consumed
  restored
  expired
}

Enum order_status {
  pending
  processing
  confirmed
  shipped
  delivered
  completed
  cancelled
  disputed
}

Enum payment_method {
  bkash
  nagad
  cod
  bank
  manual
}

Enum payment_status {
  pending
  requires_confirmation
  confirmed
  failed
  refunded
  cancelled
}

Enum shipment_status {
  pending
  packed
  shipped
  in_transit
  delivered
  returned
  failed
}

Enum wallet_tx_type {
  sale
  escrow
  withdrawal
  deposit
  membership
  borrow_pass
  borrow_fee
  refund
  adjustment
  free_credit
  donor_reward
}

Enum borrow_status {
  pending_owner_review
  counter_offered
  accepted
  rejected
  paid
  handed_over_by_owner
  borrow_active
  return_initiated
  completed
  disputed
  expired
}

Enum handover_method {
  meetup
  courier
}

Enum exchange_status {
  pending_proposal
  counter_offered
  accepted
  rejected
  handed_over
  completed
  disputed
  cancelled
}

Enum dispute_status {
  open
  under_review
  resolved
  rejected
}

Enum notification_type {
  system
  message
  borrow_request
  borrow_approved
  borrow_returned
  exchange_offer
  exchange_accepted
  review
  order
  wallet
  membership
  pass_expiry
}

Enum notification_channel {
  in_app
  websocket
  fcm
  email
}

Enum report_target_type {
  book
  user
  review
  message
  order
  borrow_order
  exchange_order
}

Enum report_status {
  submitted
  in_review
  resolved
  rejected
}

Enum strike_type {
  warning
  temporary_ban
  permanent_ban
}

Enum cms_status {
  draft
  published
  archived
}

Enum campaign_status {
  draft
  scheduled
  active
  ended
  archived
}


// Tables

Table users {
  id uuid [pk]
  email varchar [unique]
  phone varchar
  password_hash varchar
  role user_role [not null, default: 'user']
  status account_status [not null, default: 'active']
  email_verified boolean [not null, default: false]
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table locations {
  id uuid [pk]
  display_address text
  private_address text
  street varchar
  city varchar
  district varchar
  thana varchar
  state varchar
  postal_code varchar
  country varchar [default: 'Bangladesh']
  lat decimal
  lng decimal
  visibility location_visibility [not null, default: 'transaction_only']
  created_at timestamp [not null]
}

Table media_assets {
  id uuid [pk]
  owner_user_id uuid
  kind media_kind [not null]
  cloudinary_public_id varchar [not null]
  original_url text [not null]
  mime_type varchar
  size_bytes int
  width int
  height int
  processing_status processing_status [not null, default: 'pending']
  created_at timestamp [not null]
}

Table authors {
  id uuid [pk]
  name varchar [not null]
  slug varchar [unique]
  bio text
  created_at timestamp [not null]
}

Table publishers {
  id uuid [pk]
  name varchar [not null]
  slug varchar [unique]
  created_at timestamp [not null]
}

Table categories {
  id uuid [pk]
  name varchar [not null]
  bn_name varchar
  slug varchar [unique, not null]
  parent_id uuid
  image_media_id uuid
  created_at timestamp [not null]
}

Table book_metadata {
  id uuid [pk]
  isbn_10 varchar
  isbn_13 varchar [unique]
  title varchar [not null]
  slug varchar [unique, not null]
  publisher_id uuid
  language varchar
  edition varchar
  page_count int
  description text
  original_cover_url text
  source varchar [not null, default: 'manual']
  source_payload json
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table book_authors {
  book_id uuid [not null]
  author_id uuid [not null]

  indexes {
    (book_id, author_id) [pk]
  }
}

Table book_categories {
  book_id uuid [not null]
  category_id uuid [not null]

  indexes {
    (book_id, category_id) [pk]
  }
}

Table isbn_lookup_logs {
  id uuid [pk]
  isbn varchar [not null]
  source varchar [not null]
  found_local boolean [not null, default: false]
  user_id uuid
  created_at timestamp [not null]
}

Table book_listings {
  id uuid [pk]
  book_id uuid [not null]
  owner_user_id uuid
  provider_type varchar [not null, default: 'user']
  location_id uuid
  condition book_condition [not null]
  condition_note text
  status listing_status [not null, default: 'draft']
  inventory_status inventory_status [not null, default: 'available']
  quantity_total int [not null, default: 1]
  quantity_available int [not null, default: 1]
  tags json
  is_featured boolean [not null, default: false]
  is_premium_book boolean [not null, default: false]
  is_donated_book boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table book_listing_modes {
  id uuid [pk]
  listing_id uuid [not null]
  mode listing_mode [not null]
  price decimal
  original_price decimal
  deposit decimal
  borrow_fee decimal
  borrow_duration_days int
  exchange_value decimal
  exchange_preference text
  quantity int [not null, default: 1]
  active boolean [not null, default: true]
}

Table book_images {
  id uuid [pk]
  listing_id uuid [not null]
  media_id uuid [not null]
  image_role varchar [not null]
  sort_order int [not null, default: 0]
}

Table book_questions {
  id uuid [pk]
  listing_id uuid [not null]
  asker_id uuid [not null]
  question text [not null]
  created_at timestamp [not null]
}

Table book_answers {
  id uuid [pk]
  question_id uuid [not null]
  answerer_id uuid [not null]
  answer text [not null]
  created_at timestamp [not null]
}

Table review_eligibilities {
  id uuid [pk]
  user_id uuid [not null]
  target_type varchar [not null]
  target_id uuid [not null]
  source_type varchar [not null]
  source_id uuid [not null]
  used_at timestamp
  created_at timestamp [not null]
}

Table reviews {
  id uuid [pk]
  reviewer_id uuid [not null]
  target_type varchar [not null]
  target_id uuid [not null]
  eligibility_id uuid
  rating int [not null]
  body text
  transaction_type varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table review_helpful_votes {
  review_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp [not null]

  indexes {
    (review_id, user_id) [pk]
  }
}

Table badges {
  id uuid [pk]
  code varchar [unique, not null]
  name varchar [not null]
  description text
  weight int [not null, default: 0]
  icon_media_id uuid
  active boolean [not null, default: true]
}

Table user_badges {
  user_id uuid [not null]
  badge_id uuid [not null]
  awarded_reason text
  awarded_at timestamp [not null]

  indexes {
    (user_id, badge_id) [pk]
  }
}

Table reputation_scores {
  user_id uuid [pk]
  score decimal [not null, default: 0]
  avg_rating decimal
  review_count int [not null, default: 0]
  on_time_return_ratio decimal
  successful_exchange_count int [not null, default: 0]
  completed_sale_count int [not null, default: 0]
  dispute_ratio decimal
  updated_at timestamp [not null]
}

Table reputation_events {
  id uuid [pk]
  user_id uuid [not null]
  source_type varchar [not null]
  source_id uuid [not null]
  delta decimal [not null]
  reason text
  created_at timestamp [not null]
}

// Relationships inside this domain
Ref: users.id < media_assets.owner_user_id
Ref: publishers.id < book_metadata.publisher_id
Ref: book_metadata.id < book_authors.book_id
Ref: authors.id < book_authors.author_id
Ref: book_metadata.id < book_categories.book_id
Ref: categories.id < book_categories.category_id
Ref: categories.id < categories.parent_id
Ref: users.id < isbn_lookup_logs.user_id
Ref: book_metadata.id < book_listings.book_id
Ref: users.id < book_listings.owner_user_id
Ref: locations.id < book_listings.location_id
Ref: book_listings.id < book_listing_modes.listing_id
Ref: book_listings.id < book_images.listing_id
Ref: media_assets.id < book_images.media_id
Ref: book_listings.id < book_questions.listing_id
Ref: users.id < book_questions.asker_id
Ref: book_questions.id < book_answers.question_id
Ref: users.id < book_answers.answerer_id
Ref: users.id < review_eligibilities.user_id
Ref: users.id < reviews.reviewer_id
Ref: review_eligibilities.id < reviews.eligibility_id
Ref: reviews.id < review_helpful_votes.review_id
Ref: users.id < review_helpful_votes.user_id
Ref: badges.id < user_badges.badge_id
Ref: users.id < user_badges.user_id
Ref: users.id < reputation_scores.user_id
Ref: users.id < reputation_events.user_id

// Cross-domain relationships intentionally stay in the master ERD.
